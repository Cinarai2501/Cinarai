# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional: Firebase Realtime Database URL
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project.firebaseio.com

# Firebase Admin SDK (server-side only — never expose these values to the browser).
# Set either the full service-account JSON or all three individual variables.
FIREBASE_ADMIN_SDK_KEY=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# AI Services (Optional)
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
OPENAI_API_KEY=
# OPENAI_API_KEY_2=
# OPENAI_API_KEY_3=
GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_2=
# OPENROUTER_API_KEY_3=

# Internal AI request limit per analysis scope (teacher class, student UID, or module ID).
TEACHER_AI_RATE_LIMIT_MAX_REQUESTS=5
TEACHER_AI_RATE_LIMIT_WINDOW_MS=60000

# Combined server-side limit across provider-backed AI routes for each authenticated UID.
AI_USER_RATE_LIMIT_MAX_REQUESTS=20
AI_USER_RATE_LIMIT_WINDOW_MS=60000

# Development mode: unlock all comics without changing code
NEXT_PUBLIC_DEVELOPMENT_UNLOCK_ALL=true
