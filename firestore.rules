rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function authUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isTeacher() {
      return isSignedIn() && authUser().exists() && (
        authUser().data.role == 'teacher'
        || authUser().data.role == 'admin'
      );
    }

    function isAdmin() {
      return isSignedIn() && authUser().exists() && authUser().data.role == 'admin';
    }

    function hasTeacherStudentAccess(studentUid) {
      let teacher = authUser();
      let student = get(/databases/$(database)/documents/users/$(studentUid));
      return isSignedIn()
        && studentUid is string
        && teacher.exists()
        && teacher.data.role == 'teacher'
        && student.exists()
        && student.data.role == 'student';
    }

    function canReadStudentData(studentUid) {
      return isAdmin() || hasTeacherStudentAccess(studentUid);
    }

    function canReadStudentProfile(data) {
      let teacher = authUser();
      return isAdmin()
        || (isSignedIn()
          && teacher.exists()
          && teacher.data.role == 'teacher'
          && data.role == 'student');
    }

    function canReadStudentRecord(data) {
      return isSignedIn()
        && (
          (data.userId is string
            && (data.userId == request.auth.uid || canReadStudentData(data.userId)))
          || (data.studentId is string
            && (data.studentId == request.auth.uid || canReadStudentData(data.studentId)))
        );
    }

    function hasConsistentReflectionOwner(data) {
      return !('userId' in data)
        || !('studentId' in data)
        || data.userId == data.studentId;
    }

    function hasUnchangedSchoolAssignment(oldData, newData) {
      return (!('schoolName' in oldData) && !('schoolName' in newData))
        || (('schoolName' in oldData)
          && ('schoolName' in newData)
          && oldData.schoolName == newData.schoolName);
    }

    function hasUnchangedTeacherAssignment(oldData, newData) {
      return (!('teacherUid' in oldData) && !('teacherUid' in newData))
        || (('teacherUid' in oldData)
          && ('teacherUid' in newData)
          && oldData.teacherUid == newData.teacherUid);
    }

    function canAdminAssignTeacher() {
      return isAdmin()
        && resource.data.role == 'student'
        && request.resource.data.role == 'student'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherUid', 'updatedAt'])
        && (!('teacherUid' in request.resource.data)
          || (request.resource.data.teacherUid is string
            && get(/databases/$(database)/documents/users/$(request.resource.data.teacherUid)).exists()
            && get(/databases/$(database)/documents/users/$(request.resource.data.teacherUid)).data.role == 'teacher'));
    }

    function isStudent() {
      return isSignedIn() && authUser().exists() && authUser().data.role == 'student';
    }

    function ownsUserDoc(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasGradedCinaraiEvaluation(data) {
      return data.evaluationCinarai is map
        && data.evaluationCinarai.grading is map
        && data.evaluationCinarai.grading.status == 'graded';
    }

    function isValidCinaraiRubricScore(scores, challengeId) {
      return scores[challengeId] is int
        && scores[challengeId] >= 0
        && scores[challengeId] <= 4;
    }

    function hasAllCinaraiRubricScores(scores) {
      return scores is map
        && scores.keys().hasAll([
          'challenge1', 'challenge2', 'challenge3', 'challenge4', 'challenge5',
          'challenge6', 'challenge7', 'challenge8', 'challenge9', 'challenge10'
        ])
        && scores.keys().hasOnly([
          'challenge1', 'challenge2', 'challenge3', 'challenge4', 'challenge5',
          'challenge6', 'challenge7', 'challenge8', 'challenge9', 'challenge10'
        ])
        && isValidCinaraiRubricScore(scores, 'challenge1')
        && isValidCinaraiRubricScore(scores, 'challenge2')
        && isValidCinaraiRubricScore(scores, 'challenge3')
        && isValidCinaraiRubricScore(scores, 'challenge4')
        && isValidCinaraiRubricScore(scores, 'challenge5')
        && isValidCinaraiRubricScore(scores, 'challenge6')
        && isValidCinaraiRubricScore(scores, 'challenge7')
        && isValidCinaraiRubricScore(scores, 'challenge8')
        && isValidCinaraiRubricScore(scores, 'challenge9')
        && isValidCinaraiRubricScore(scores, 'challenge10');
    }

    function canTeacherGradeCinaraiEvaluation(uid, progressId) {
      return progressId == 'evaluation-cinarai'
        && isAdmin()
        && canReadStudentData(uid)
        && resource.data.evaluationCinarai.completed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['evaluationCinarai', 'updatedAt'])
        && request.resource.data.evaluationCinarai.diff(resource.data.evaluationCinarai).affectedKeys().hasOnly(['grading'])
        && request.resource.data.evaluationCinarai.answers == resource.data.evaluationCinarai.answers
        && request.resource.data.evaluationCinarai.completed == resource.data.evaluationCinarai.completed
        && request.resource.data.evaluationCinarai.grading.status == 'graded'
        && request.resource.data.evaluationCinarai.grading.gradedBy == request.auth.uid
        && request.resource.data.evaluationCinarai.grading.rubricVersion == 'cinarai-0-4-v1'
        && request.resource.data.evaluationCinarai.grading.totalScore is int
        && request.resource.data.evaluationCinarai.grading.totalScore >= 0
        && request.resource.data.evaluationCinarai.grading.totalScore <= 40
        && hasAllCinaraiRubricScores(request.resource.data.evaluationCinarai.grading.challengeScores);
    }

    match /users/{uid} {
      allow read: if ownsUserDoc(uid) || canReadStudentProfile(resource.data);
      // School scope is assigned by trusted admin tooling, not self-selected by clients.
      allow create: if ownsUserDoc(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['student', 'teacher']
        && !('schoolName' in request.resource.data)
        && !('teacherUid' in request.resource.data);
      allow update: if (
          ownsUserDoc(uid)
          && request.resource.data.uid == uid
          && request.resource.data.role == resource.data.role
          && hasUnchangedSchoolAssignment(resource.data, request.resource.data)
          && hasUnchangedTeacherAssignment(resource.data, request.resource.data)
        ) || canAdminAssignTeacher();
      allow delete: if ownsUserDoc(uid);

      match /progress/{comicId} {
        allow read: if ownsUserDoc(uid) || canReadStudentData(uid);
        allow create: if ownsUserDoc(uid)
          && (comicId != 'evaluation-cinarai' || !hasGradedCinaraiEvaluation(request.resource.data));
        allow update: if (
            ownsUserDoc(uid)
            && (comicId != 'evaluation-cinarai'
              || !hasGradedCinaraiEvaluation(resource.data)
              || (
                request.resource.data.evaluationCinarai.grading == resource.data.evaluationCinarai.grading
                && request.resource.data.evaluationCinarai.answers == resource.data.evaluationCinarai.answers
                && request.resource.data.evaluationCinarai.completed == resource.data.evaluationCinarai.completed
              ))
          ) || canTeacherGradeCinaraiEvaluation(uid, comicId);
        allow delete: if ownsUserDoc(uid)
          && (comicId != 'evaluation-cinarai' || !hasGradedCinaraiEvaluation(resource.data));
      }

      match /learning-module-progress/{moduleId} {
        allow read: if ownsUserDoc(uid) || canReadStudentData(uid);
        allow write: if isSignedIn() && ownsUserDoc(uid);
      }

      match /daily_motivation/{date} {
        allow read: if ownsUserDoc(uid) || isAdmin();
        allow write: if isSignedIn() && ownsUserDoc(uid);
      }

      match /aiTutorChats/{chatId} {
        allow read: if ownsUserDoc(uid) || canReadStudentData(uid);
        allow create, update, delete: if ownsUserDoc(uid);
      }
    }

    match /dashboard/{docId} {
      allow read: if isAdmin()
        || (isSignedIn()
          && authUser().exists()
          && authUser().data.role == 'teacher'
          && resource.data.teacherUid == request.auth.uid);
      allow write: if false;
    }

    // ── reflection ───────────────────────────────────────────────────────────
    match /reflection/{docId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || resource.data.studentId == request.auth.uid
        || canReadStudentRecord(resource.data)
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid
        || request.resource.data.studentId == request.auth.uid
      ) && hasConsistentReflectionOwner(request.resource.data);
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      )
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.studentId == resource.data.studentId
        && hasConsistentReflectionOwner(request.resource.data);
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );
    }

    match /activity/{docId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || canReadStudentRecord(resource.data)
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /application_activity/{docId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || canReadStudentRecord(resource.data)
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /identification_answers/{docId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || canReadStudentRecord(resource.data)
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── comics ────────────────────────────────────────────────────────────
    // Metadata komik: read publik, write hanya via Admin SDK / seed script
    match /comics/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /progress/{docId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || canReadStudentRecord(resource.data)
      );
      allow write: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Semua collection lain: tolak ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
